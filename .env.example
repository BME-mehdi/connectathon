# Supabase (local: from `npx supabase start` output, or your hosted project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to build absolute redirect URLs (invite emails, auth callback) outside a request context
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n (local docker-compose: http://localhost:5678/webhook)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# Shared secret n8n must send as the `x-webhook-secret` header when calling
# POST /api/scoring-webhook (service-role route — never leave this unset)
SCORING_WEBHOOK_SECRET=

# WHO lifestyle companion — local Ollama instance running medgemma
# (see scripts/ or your own Ollama setup; defaults match a stock local install)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=medgemma
